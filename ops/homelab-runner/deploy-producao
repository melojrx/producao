#!/bin/sh
set -eu

PRODUCAO_ROOT='/srv/producao'
CONTROLLER='/usr/local/lib/producao/deploy-stack.sh'
release_directory=${1:?Usage: deploy-producao <release-directory>}

case "$release_directory" in "$PRODUCAO_ROOT"/releases/sha256-*) ;; *) printf '%s\n' 'Invalid release directory.' >&2; exit 1 ;; esac
[ "$#" -eq 1 ] || { printf '%s\n' 'Usage: deploy-producao <release-directory>' >&2; exit 1; }
[ -x "$CONTROLLER" ] || { printf '%s\n' 'Root-owned deploy controller is not executable.' >&2; exit 1; }
[ -r "$release_directory/images.env" ] || { printf '%s\n' 'Release images are not readable.' >&2; exit 1; }
if find "$release_directory" -xdev \( ! -user root -o -perm /022 \) -print -quit | grep -q .; then
  printf '%s\n' 'Release contents must be root-owned and not group/world writable.' >&2
  exit 1
fi
exec "$CONTROLLER" "$release_directory"
